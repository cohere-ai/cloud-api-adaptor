#!/usr/bin/bash
set -euo pipefail

log() {
    echo "[process-user-data-debug] $(date -Is) $*"
}

dump_state() {
    log "cmdline: $(cat /proc/cmdline)"
    log "tdx_guest devices:"
    ls -l /dev/tdx_guest /sys/devices/virtual/misc/tdx_guest/measurements 2>&1 || true
    log "peerpod runtime files:"
    ls -l /run/peerpod /run/peerpod/* 2>&1 || true
    if [ -f /run/peerpod/initdata ]; then
        wc -c /run/peerpod/initdata 2>&1 || true
        sha384sum /run/peerpod/initdata 2>&1 || true
    fi
    if [ -f /run/peerpod/initdata.digest ]; then
        log "initdata.digest: $(tr -d '[:space:]' < /run/peerpod/initdata.digest)"
    fi
}

on_error() {
    local rc=$?
    log "failed with exit code ${rc} at line ${BASH_LINENO[0]}"
    dump_state
    exit "${rc}"
}
trap on_error ERR

log "starting process-user-data provision-files"
dump_state
/usr/local/bin/process-user-data provision-files
log "process-user-data provision-files completed"
dump_state
