# syntax=docker/dockerfile:1.5.0-labs
# ubuntu:24.10 (Oracular) — provides systemd 256 EFI stub with TDX RTMR support
FROM ubuntu@sha256:cdf755952ed117f6126ff4e65810bf93767d4c38f5c7185b50ec1f1078b464cc AS builder

ARG MKOSI_VERSION="v26"
ARG PROFILE="debug"
ARG IMAGE_VERSION="0.0.0"

ARG DEBIAN_FRONTEND=noninteractive

# 24.10 is EOL; redirect apt to old-releases mirror
RUN sed -i 's|archive.ubuntu.com|old-releases.ubuntu.com|g; s|security.ubuntu.com|old-releases.ubuntu.com|g' \
	/etc/apt/sources.list.d/ubuntu.sources

RUN apt-get update && \
	apt-get install -y \
	bubblewrap \
	curl \
	git \
	gnupg \
	cpio \
	systemd-repart \
	kmod \
	systemd-boot-efi \
	libcryptsetup12 \
	squashfs-tools \
	systemd-ukify \
	dosfstools \
	mtools \
	python3 \
	debian-archive-keyring \
	zstd

RUN mkdir -p /build
WORKDIR /build
RUN git clone -b "$MKOSI_VERSION" https://github.com/systemd/mkosi
ENV PATH="/build/mkosi/bin:$PATH"
RUN mkosi --version

RUN mkdir /image
WORKDIR /image
COPY mkosi.images /image/mkosi.images
COPY mkosi.skeleton-debug /image/mkosi.skeleton-debug
COPY mkosi.skeleton-debug-ubuntu /image/mkosi.skeleton-debug-ubuntu
COPY mkosi.skeleton-sftp /image/mkosi.skeleton-sftp
COPY mkosi.sandbox /image/mkosi.sandbox
COPY mkosi.workspace /image/mkosi.workspace
COPY resources /image/resources
COPY mkosi.conf.ubuntu /image/mkosi.conf

# Add NVIDIA APT keyrings to mkosi's sandbox. The corresponding source and
# preference files are checked in under mkosi.sandbox.
RUN mkdir -p /image/mkosi.sandbox/usr/share/keyrings \
    && curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-archive-keyring.gpg \
       -o /image/mkosi.sandbox/usr/share/keyrings/cuda-archive-keyring.gpg \
    && curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey \
       | gpg --dearmor -o /image/mkosi.sandbox/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg

RUN --security=insecure mkosi --profile=$PROFILE --image-version=$IMAGE_VERSION

FROM scratch

COPY --from=builder /image/build/system.raw /
